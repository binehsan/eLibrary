
module nginx_gunicorn 1.0;

require {
	type httpd_t;
	type user_home_t;
	type var_run_t;
	type init_t;
	class file { execute read };
	class sock_file write;
}

#============= httpd_t ==============
allow httpd_t var_run_t:sock_file write;

#============= init_t ==============
allow init_t user_home_t:file { execute read };
